# ============================================================
# Achariya AI ONE — Environment Configuration
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit your real .env file to version control.
#
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================

PORT=4000
NODE_ENV=development

# REQUIRED — set strong, unique values before starting the server
JWT_SECRET=<generate-a-strong-random-secret>
SSO_HMAC_SECRET=<generate-a-strong-random-secret>

JWT_EXPIRES_IN=24h

# OPTIONAL — AI service API keys (at least one OCR key recommended for grading)
CLOUD_VISION_API_KEY=
WHISPER_API_KEY=
GEMINI_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (Docker Compose): run `docker compose up -d` first
DATABASE_URL="postgresql://achariya:achariya_dev_pass@localhost:5432/achariya_one"

# Production example (replace with your managed PostgreSQL URL):
# DATABASE_URL="postgresql://user:password@host:5432/achariya_prod?sslmode=require"
